{
  "name": "chatgpt-recorder",
  "version": "0.1.0",
  "description": "YouTube video generation, capture extension and scheduled-upload automation",
  "type": "module",
  "scripts": {
    "verify": "bash scripts/check-quality.sh",
    "lint": "eslint src/ --max-warnings 0",
    "test": "bash scripts/run-tests.sh",
    "build": "bash scripts/package-extension.sh",
    "build:chrome": "python3 scripts/build-chrome.py",
    "test:chrome": "npm run build:chrome && python3 -u tests/browser/chrome_audio_e2e.py"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "web-ext": "^10.6.0"
  }
}
