{
  "manifest_version": 3,
  "name": "ChatGPT Audio Capture",
  "version": "0.1.0",
  "description": "Captura automaticamente o áudio de Read Aloud do ChatGPT e salva localmente.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://*.oaiusercontent.com/*"
  ],
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://chatgpt.com/*"],
      "js": ["src/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": "icons/icon-idle.svg",
    "default_title": "ChatGPT Audio Capture",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Open ChatGPT Audio Capture Popup"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-audio-capture@zaflas.local",
      "strict_min_version": "115.0"
    }
  }
}
